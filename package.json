{
  "name": "h264-decode-probe",
  "version": "0.1.0",
  "description": "Tiny WebCodecs H264 decode probe with embedded real Annex B samples.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./samples": "./src/sample-data.js"
  },
  "files": [
    "dist",
    "src",
    "samples"
  ],
  "scripts": {
    "build:samples": "node scripts/embed-samples.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node --check src/index.js && node --check src/sample-data.js && node --check src/main.js && vite build"
  },
  "keywords": [
    "h264",
    "webcodecs",
    "probe",
    "avc"
  ],
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "terser": "^5.43.1",
    "vite": "^7.2.7"
  }
}
